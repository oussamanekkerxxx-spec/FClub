# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudinary (unsigned upload preset)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_name

# Optional demo login (development only)
VITE_DEMO_EMAIL=demo@fightclub.test
VITE_DEMO_PASSWORD=demo_password_here

# Optional password reset redirect override
# Example local: http://localhost:5173/login
# Example production: https://f-club.vercel.app/login
VITE_AUTH_PASSWORD_RESET_REDIRECT_URL=

# Voice rooms (LiveKit)
# Public websocket URL fallback (optional if API returns wsUrl)
VITE_LIVEKIT_WS_URL=
# Token endpoint (defaults to /api/livekit-token)
VITE_LIVEKIT_TOKEN_ENDPOINT=/api/livekit-token

# Server-side env vars (set in Vercel project settings):
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
# LIVEKIT_WS_URL=wss://your-project.livekit.cloud

# Edge Function secrets (set via Supabase CLI, NOT stored in .env):
#   supabase secrets set MINDEE_API_KEY=<your_key>
#   Get your API key at https://platform.mindee.com
#   Free tier: 250 calls/month — enough for development + early production
#
# To deploy the verify-id function:
#   supabase functions deploy verify-id
